name: "wide_and_deep"
platform: "tensorflow_savedmodel"
max_batch_size: 0
input [
  { name: "user_id" data_type: TYPE_INT64 dims: [ -1 ] },
  { name: "movie_id" data_type: TYPE_INT64 dims: [ -1 ] },
  { name: "user_log_interactions" data_type: TYPE_FP32 dims: [ -1 ] },
  { name: "user_mean_rating" data_type: TYPE_FP32 dims: [ -1 ] },
  { name: "user_positive_rate" data_type: TYPE_FP32 dims: [ -1 ] },
  { name: "user_log_recency" data_type: TYPE_FP32 dims: [ -1 ] },
  { name: "item_log_interactions" data_type: TYPE_FP32 dims: [ -1 ] },
  { name: "item_mean_rating" data_type: TYPE_FP32 dims: [ -1 ] },
  { name: "item_positive_rate" data_type: TYPE_FP32 dims: [ -1 ] },
  { name: "item_popularity_score" data_type: TYPE_FP32 dims: [ -1 ] },
  { name: "item_log_age" data_type: TYPE_FP32 dims: [ -1 ] },
  { name: "retrieval_score" data_type: TYPE_FP32 dims: [ -1 ] }
]
output [
  { name: "logit" data_type: TYPE_FP32 dims: [ -1 ] }
]
instance_group [
  { kind: KIND_CPU count: 1 }
]
version_policy: { specific: { versions: 1 } }
